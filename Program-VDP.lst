000000r 2               SID_NOTE_Bb7        = SID_NOTE_AS7
000000r 2               ; Note: B7 (~3951 Hz = $102F0) exceeds the 16-bit SID register — not defined
000000r 2               
000000r 2               ; --- Video Card (6502-PICOVDP) (IO 8: $9C00-$9C03) ---
000000r 2               ;   Two complete, independent port pairs.  Each has its own VRAM pointer,
000000r 2               ;   read-ahead byte, command flip-flop and status selector; both reach the
000000r 2               ;   same 64 KB of VRAM and the same registers (VBANK and VINC included).
000000r 2               ;   Use port A in foreground code and port B in interrupt handlers, and a
000000r 2               ;   handler never breaks a command pair half written — no sei/cli needed
000000r 2               ;   around VDP work.  A handler that writes VBANK or VINC puts them back.
000000r 2               ;
000000r 2               ;   The command protocol is the TMS9918's, on either port: two writes to the
000000r 2               ;   command port, a payload byte P and then a command byte C.
000000r 2               ;     Register write:    P = value,       C = VC_REG_WRITE  | register (0-127)
000000r 2               ;     VRAM write addr:   P = address low, C = VC_ADDR_WRITE | address bits 13:8
000000r 2               ;     VRAM read addr:    P = address low, C = address bits 13:8 (prefetches)
000000r 2               ;   Address bits 15:14 come from VBANK.  After each VC_DATA access the pointer
000000r 2               ;   moves by VINC (reset +1), carrying into the bank bits.
000000r 2               ;   Reading a status port returns the status register its STATSEL names, and
000000r 2               ;   resets that pair's flip-flop — read status once to resynchronize.
000000r 2               VC_DATA             := $9C00             ; R/W — Port A VRAM data (pointer advances by VINC)
000000r 2               VC_REG              := $9C01             ; Write — Port A command (register / address)
000000r 2               VC_STATUS           := $9C01             ; Read — Port A status (register named by STATSEL_A)
000000r 2               VC_DATA2            := $9C02             ; R/W — Port B VRAM data (for interrupt handlers)
000000r 2               VC_REG2             := $9C03             ; Write — Port B command
000000r 2               VC_STATUS2          := $9C03             ; Read — Port B status (register named by STATSEL_B)
000000r 2               
000000r 2               ; Command byte bits (second write to VC_REG / VC_REG2):
000000r 2               VC_REG_WRITE        = $80                ; %1rrrrrrr — write register r with the payload
000000r 2               VC_ADDR_WRITE       = $40                ; %01aaaaaa — set the VRAM pointer for writing
000000r 2                                                        ; %00aaaaaa — set it for reading (no bit to OR in)
000000r 2               
000000r 2               ; Register numbers (write-only; read state back through the status registers).
000000r 2               ;   Registers $02-$06 are aliases of L0NAME, L0ATTR, L0PAT, SPRATTR and SPRPAT,
000000r 2               ;   so a TMS9918 program's writes to registers 2-6 reach them.  The names
000000r 2               ;   below are the block addresses; the aliases get no names of their own.
000000r 2               ; $00-$07 — Legacy core
000000r 2               VC_REG_MODE0        = $00                ; b1 M3 (see VC_MODE0_*)
000000r 2               VC_REG_MODE1        = $01                ; DISP, IE, M1, M2, SPRSIZE, SPRMAG (see VC_MODE1_*)
000000r 2               VC_REG_COLOR        = $07                ; b7:4 default foreground, b3:0 backdrop/border
000000r 2               ; $08-$0F — Access and interrupts
000000r 2               VC_REG_VBANK        = $08                ; VRAM address bits 15:14 (b1:0), sampled by an address command
000000r 2               VC_REG_VINC         = $09                ; Pointer stride, signed -128..+127 ($00 = none; reset $01)
000000r 2               VC_REG_IRQEN        = $0A                ; Interrupt enables (see VC_IRQ_*)
000000r 2               VC_REG_IRQLINE      = $0B                ; Scanline compare, display line 0-255
000000r 2               VC_REG_PALBASE      = $0C                ; Palette base, b5:0 × $400 (reset $3F = VC_PALETTE)
000000r 2               VC_REG_VMODE        = $0D                ; Display mode (see VC_VMODE_*)
000000r 2               VC_REG_STATSEL_B    = $0E                ; Status register port B reads (0-15)
000000r 2               VC_REG_STATSEL_A    = $0F                ; Status register port A reads (0-15)
000000r 2               ; $10-$17 — Layer 0
000000r 2               VC_REG_L0NAME       = $10                ; Name table base, × $400 (alias $02)
000000r 2               VC_REG_L0ATTR       = $11                ; Attribute table base, × $400 (alias $03)
000000r 2               VC_REG_L0PAT        = $12                ; Pattern table base, × $800 (alias $04)
000000r 2               VC_REG_L0SCRX       = $13                ; Horizontal scroll, bits 7:0 (bit 8 is VC_LCTRL_SCRX8)
000000r 2               VC_REG_L0SCRY       = $14                ; Vertical scroll, pixels
000000r 2               VC_REG_L0CTRL       = $15                ; Depth, attribute source, enable, opacity (see VC_LCTRL_*; reset $3C)
000000r 2               VC_REG_L0PAL        = $16                ; b3:0 palette group high bits
000000r 2               ; $18-$1F — Layer 1 (reset: disabled, index 0 transparent)
000000r 2               VC_REG_L1NAME       = $18                ; Name table base, × $400
000000r 2               VC_REG_L1ATTR       = $19                ; Attribute table base, × $400
000000r 2               VC_REG_L1PAT        = $1A                ; Pattern table base, × $800
000000r 2               VC_REG_L1SCRX       = $1B                ; Horizontal scroll, bits 7:0 (bit 8 is VC_LCTRL_SCRX8)
000000r 2               VC_REG_L1SCRY       = $1C                ; Vertical scroll, pixels
000000r 2               VC_REG_L1CTRL       = $1D                ; As L0CTRL (reset $0C)
000000r 2               VC_REG_L1PAL        = $1E                ; b3:0 palette group high bits
000000r 2               ; $20-$27 — Sprites
000000r 2               VC_REG_SPRATTR      = $20                ; Sprite attribute table base, × $80 (alias $05)
000000r 2               VC_REG_SPRPAT       = $21                ; Sprite pattern table base, × $800 (alias $06)
000000r 2               VC_REG_SPRCOUNT     = $22                ; Active sprite slots, 0-64 (reset 32)
000000r 2               VC_REG_SPRCTRL      = $23                ; Enable, collision, $D0 terminator, depth (see VC_SPRCTRL_*; reset $27)
000000r 2               VC_REG_SPRLIMIT     = $24                ; Sprites drawn per scanline, 1-32 (reset 16)
000000r 2               VC_REG_SPRPAL       = $25                ; b3:0 palette group high bits for sprites
000000r 2               ; $28-$7F — Font, and reserved ($28-$2F are reserved for a blitter)
000000r 2               VC_REG_FONT         = $30                ; Load a built-in font: b7 layer, b6:0 font ID (see VC_FONT_*)
000000r 2               ; $17, $1F, $26-$27, $28-$2F and $31-$7F are reserved: write 0.
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 6: USEFUL CONSTANTS
000000r 2               ; =============================================================================
000000r 2               
000000r 2               ; --- BIOS Version ---
000000r 2               BIOS_VERSION_MAJOR  = 2
000000r 2               BIOS_VERSION_MINOR  = 0
000000r 2               
000000r 2               ; --- NVRAM Save Slots (v1.6) ---
000000r 2               NV_SLOTS            = 16                 ; Save slots in RTC NVRAM
000000r 2               NV_SLOT_SIZE        = 16                 ; Bytes per slot (slot n at NVRAM n*16)
000000r 2               NV_SLOT_DATA        = 14                 ; Payload bytes per slot
000000r 2               NV_CK_SEED          = $A6                ; Checksum seed
000000r 2               NV_EMPTY            = 0                  ; NvStat: slot is free
000000r 2               NV_VALID            = 1                  ; NvStat: owner ID set, checksum agrees
000000r 2               NV_BAD              = 2                  ; NvStat: owner ID set, checksum does not
000000r 2               
000000r 2               ; --- ASCII Control Characters ---
000000r 2               CHAR_BEL            = $07                ; Bell (Beep via SID)
000000r 2               CHAR_BS             = $08                ; Backspace (cursor left + erase in video mode)
000000r 2               CHAR_LF             = $0A                ; Line Feed (cursor down, scroll if at bottom)
000000r 2               CHAR_CR             = $0D                ; Carriage Return (cursor to column 0)
000000r 2               CHAR_ESC            = $1B                ; Escape
000000r 2               CHAR_SPACE          = $20                ; Space
000000r 2               
000000r 2               ; --- Video Dimensions (Text mode) ---
000000r 2               ;   The text console's layout, which the PICOVDP's Text mode keeps.
000000r 2               VID_COLS            = 40                 ; Screen width in columns
000000r 2               VID_ROWS            = 24                 ; Screen height in rows
000000r 2               VID_NAME_TABLE      = $0000              ; VRAM address of name table (40×24 = 960 bytes; L0NAME = $00)
000000r 2               VID_ATTR_TABLE      = $0400              ; VRAM address of attribute table (960 bytes, fg<<4 | bg; L0ATTR = $01)
000000r 2               VID_PATTERN_TABLE   = $0800              ; VRAM address of pattern/character table (2048 bytes; L0PAT = $01)
000000r 2               
000000r 2               ; --- 6502-PICOVDP: MODE0 / MODE1 bits ---
000000r 2               ;   M1, M2 and M3 select the display mode only while VMODE is VC_VMODE_LEGACY.
000000r 2               VC_MODE0_M3         = %00000010          ; M3 legacy mode select
000000r 2               VC_MODE1_DISP       = %01000000          ; Display enable (clear: backdrop only)
000000r 2               VC_MODE1_IE         = %00100000          ; Vertical blank IRQ enable (alias of VC_IRQ_VBLANK in IRQEN)
000000r 2               VC_MODE1_M1         = %00010000          ; M1 legacy mode select (Text)
000000r 2               VC_MODE1_M2         = %00001000          ; M2 legacy mode select
000000r 2               VC_MODE1_SPRSIZE    = %00000010          ; Sprite size: 0 = 8×8, 1 = 16×16
000000r 2               VC_MODE1_SPRMAG     = %00000001          ; Magnify sprites ×2
000000r 2               
000000r 2               ; --- 6502-PICOVDP: VMODE values ---
000000r 2               VC_VMODE_LEGACY     = $0                 ; M1/M2/M3 select the mode (reset); $5-$F behave as $0
000000r 2               VC_VMODE_TEXT       = $1                 ; 40×24 cells of 6×8, 240×192
000000r 2               VC_VMODE_COMPACT    = $2                 ; 32×24 cells of 8×8, 256×192
000000r 2               VC_VMODE_GRAPHICS   = $3                 ; 32×30 cells of 8×8, 256×240
000000r 2               VC_VMODE_FULL       = $4                 ; 40×30 cells of 8×8, 320×240, no border
000000r 2               
000000r 2               ; --- 6502-PICOVDP: L0CTRL / L1CTRL bits ---
000000r 2               ;   Pick one depth and one attribute source, then OR in the flags.
000000r 2               VC_LCTRL_1BPP       = $00                ; b1:0 bit depth — 8 bytes per tile
000000r 2               VC_LCTRL_2BPP       = $01                ;   16 bytes per tile
000000r 2               VC_LCTRL_4BPP       = $02                ;   32 bytes per tile
000000r 2               VC_LCTRL_8BPP       = $03                ;   64 bytes per tile
000000r 2               VC_LCTRL_ATTR_CELL  = $00                ; b3:2 attribute source — one byte per cell at LxATTR + cell
000000r 2               VC_LCTRL_ATTR_GROUP = $04                ;   one byte per 8 patterns at LxATTR + (pattern >> 3)
000000r 2               VC_LCTRL_ATTR_ROW   = $08                ;   one byte per pattern row at LxATTR + pattern × 8 + row
000000r 2               VC_LCTRL_ATTR_NONE  = $0C                ;   no attribute fetch
000000r 2               VC_LCTRL_ENABLE     = $10                ; b4 layer enable
000000r 2               VC_LCTRL_OPAQUE     = $20                ; b5 index 0 opaque
000000r 2               VC_LCTRL_SCRX8      = $40                ; b6 horizontal scroll bit 8 (Full mode's 320 pixels)
000000r 2               
000000r 2               ; --- 6502-PICOVDP: attribute byte (layers at 2/4/8bpp, and sprites) ---
000000r 2               ;   At 1bpp a layer's colour byte is foreground (b7:4) and background (b3:0).
000000r 2               VC_ATTR_SUBPAL      = $0F                ; b3:0 sub-palette (ignored by an 8bpp layer)
000000r 2               VC_ATTR_FLIPH       = $10                ; b4 flip horizontally
000000r 2               VC_ATTR_FLIPV       = $20                ; b5 flip vertically
000000r 2               VC_ATTR_PRIORITY    = $40                ; b6 priority (layer tile in front of sprites; sprite in front of layer 1)
000000r 2               VC_ATTR_BIT8        = $80                ; b7 layer: pattern index bit 8 (2/4bpp); sprite: X bit 8
000000r 2               
000000r 2               ; --- 6502-PICOVDP: SPRCTRL bits ---
000000r 2               VC_SPRCTRL_ENABLE   = $01                ; b0 sprites enable
000000r 2               VC_SPRCTRL_COLLIDE  = $02                ; b1 collision detection enable
000000r 2               VC_SPRCTRL_TERM     = $04                ; b2 a Y of VC_SPRITE_END ends the sprite list
000000r 2               VC_SPRCTRL_DETAIL   = $08                ; b3 detailed collision map (STAT8-STAT15)
000000r 2               VC_SPRCTRL_1BPP     = $00                ; b5:4 sprite bit depth
000000r 2               VC_SPRCTRL_2BPP     = $10
000000r 2               VC_SPRCTRL_4BPP     = $20
000000r 2               VC_SPRCTRL_8BPP     = $30
000000r 2               
000000r 2               ; --- 6502-PICOVDP: interrupt sources (IRQEN bits, latched in STAT1) ---
000000r 2               VC_IRQ_VBLANK       = $01                ; b0 end of the active picture, once a frame
000000r 2               VC_IRQ_SCANLINE     = $02                ; b1 display line matches IRQLINE
000000r 2               VC_IRQ_OVERFLOW     = $04                ; b2 a sprite was dropped, at most once a frame
000000r 2               VC_IRQ_COLLISION    = $08                ; b3 two sprites collided, at most once a frame
000000r 2               
000000r 2               ; --- 6502-PICOVDP: status registers (values for STATSEL_A / STATSEL_B) ---
000000r 2               ;   Reading STAT0 clears its flags, STAT7, the collision map and the vblank,
000000r 2               ;   overflow and collision latches in STAT1.  Reading STAT1 clears only the
000000r 2               ;   STAT1 latches — so a handler on port B reads STAT1 and foreground code
000000r 2               ;   polling STAT0 on port A still sees F.  Read STAT7 and the collision map
000000r 2               ;   before STAT0.
000000r 2               VC_STAT0            = 0                  ; F, OVF, COL, first sprite dropped (TMS9918 status)
000000r 2               VC_STAT1            = 1                  ; Latched interrupt sources still enabled in IRQEN
000000r 2               VC_STAT2            = 2                  ; Current display line, low 8 bits
000000r 2               VC_STAT3            = 3                  ; Blanking (see VC_STAT3_*)
000000r 2               VC_STAT4            = 4                  ; Identification byte, VC_ID
000000r 2               VC_STAT5            = 5                  ; Firmware version, BCD (high nibble major, low nibble minor)
000000r 2               VC_STAT6            = 6                  ; Capabilities (see VC_CAP_*)
000000r 2               VC_STAT7            = 7                  ; Index (0-63) of the first sprite dropped on the latest overflowing line
000000r 2               VC_STAT_COLLIDE     = 8                  ; STAT8-STAT15: collision map, sprite s is bit s mod 8 of STAT(8 + s/8)
000000r 2               
000000r 2               VC_STAT0_F          = $80                ; A picture has ended (set whatever IRQEN holds)
000000r 2               VC_STAT0_OVF        = $40                ; A sprite has been dropped
000000r 2               VC_STAT0_COL        = $20                ; Two sprites have collided
000000r 2               VC_STAT0_SPRITE     = $1F                ; Low five bits of the first sprite dropped
000000r 2               
000000r 2               VC_STAT3_VBLANK     = $01                ; Vertical blanking (borders included)
000000r 2               VC_STAT3_HBLANK     = $02                ; Horizontal blanking (advisory)
000000r 2               
000000r 2               VC_ID               = $AC                ; STAT4 on a 6502-PICOVDP
000000r 2               
000000r 2               VC_CAP_LAYER2       = $01                ; STAT6 b0 two layers
000000r 2               VC_CAP_8BPP         = $02                ; STAT6 b1 8bpp layer
000000r 2               VC_CAP_FLIP         = $04                ; STAT6 b2 sprite flip
000000r 2               VC_CAP_SCROLL       = $08                ; STAT6 b3 hardware scroll
000000r 2               VC_CAP_SCANLINE     = $10                ; STAT6 b4 scanline IRQ
000000r 2               VC_CAP_VRAM64K      = $20                ; STAT6 b5 64 KB VRAM
000000r 2                                                        ; STAT6 b6 reserved (a blitter)
000000r 2               VC_CAP_FONT         = $80                ; STAT6 b7 built-in font: VC_REG_FONT and font $00, loaded at reset
000000r 2               
000000r 2               ; --- 6502-PICOVDP: FONT values ---
000000r 2               ;   Reset writes font VC_FONT_CP437 to $0800-$0FFF (VID_PATTERN_TABLE), so a
000000r 2               ;   program that selects Text and sets L0PAT = $01 finds it already there.
000000r 2               ;   InitVideo loads it again, and VdpLoadFont loads it for layer 0 and waits.
000000r 2               ;   A write to VC_REG_FONT loads a font into a layer's pattern table:
000000r 2               ;   OR a layer into a font ID, e.g. VC_FONT_LAYER1 | VC_FONT_CP437.
000000r 2               ;     * Every write is a command, even of the value already held.
000000r 2               ;     * The destination is LxPAT × $800, sampled at the write; a later write
000000r 2               ;       to L0PAT/L1PAT does not move a pending load.
000000r 2               ;     * A reserved font ID ($01-$7F) is stored and does nothing else.
000000r 2               ;     * One load is pending per layer; a second write for that layer replaces it.
000000r 2               ;     * The load completes at the line start where vertical blank fires, before
000000r 2               ;       VC_STAT0_F sets.  Until then the table keeps its old contents, and a
000000r 2               ;       write there is overwritten.  So: read STAT0 to clear F, write
000000r 2               ;       VC_REG_FONT, and wait for F before touching that range.
000000r 2               ;     * A reset cancels every pending load.
000000r 2               ;   Check VC_CAP_FONT in STAT6 first.
000000r 2               VC_FONT_LAYER0      = $00                ; b7 clear: layer 0's pattern table (L0PAT × $800)
000000r 2               VC_FONT_LAYER1      = $80                ; b7 set: layer 1's pattern table (L1PAT × $800)
000000r 2               VC_FONT_CP437       = $00                ; Font $00: CP437, 6×8, 2,048 bytes (glyph n at n × 8)
000000r 2               
000000r 2               ; --- 6502-PICOVDP: VRAM ---
000000r 2               VC_PALETTE          = $FC00              ; Palette at reset PALBASE: 256 entries of %0000RRRR, %GGGGBBBB
000000r 2               VC_SPRITE_END       = $D0                ; Sprite Y that ends the list while VC_SPRCTRL_TERM is set
000000r 2               
000000r 2               ; --- Colour Constants (palette row 0) ---
000000r 2               ;   The PICOVDP's default palette puts the sixteen TMS9918 colours in row 0
000000r 2               ;   at their TMS9918 indices, so these name the same colours they always did.
000000r 2               ;   At 1bpp they are the foreground and background nibbles, and for
000000r 2               ;   VideoSetColor (the pen; its background nibble is also the border).
000000r 2               ;   Index 0 is transparent unless the layer is opaque.
000000r 2               ;   Pass as: (foreground << 4) | background
000000r 2               ;   Example: white on black = $F0, green on black = $20
000000r 2               TMS_TRANSPARENT     = $0
000000r 2               TMS_BLACK           = $1
000000r 2               TMS_MED_GREEN       = $2
000000r 2               TMS_LT_GREEN        = $3
000000r 2               TMS_DK_BLUE         = $4
000000r 2               TMS_LT_BLUE         = $5
000000r 2               TMS_DK_RED          = $6
000000r 2               TMS_CYAN            = $7
000000r 2               TMS_MED_RED         = $8
000000r 2               TMS_LT_RED          = $9
000000r 2               TMS_DK_YELLOW       = $A
000000r 2               TMS_LT_YELLOW       = $B
000000r 2               TMS_DK_GREEN        = $C
000000r 2               TMS_MAGENTA         = $D
000000r 2               TMS_GRAY            = $E
000000r 2               TMS_WHITE           = $F
000000r 2               
000000r 1               .else
000000r 1               .include "6502.inc"
000000r 1               .endif
000000r 1               
000000r 1               .segment "CODE"
000000r 1               
000000r 1               ; =============================================================================
000000r 1               ;   BASIC Startup Stub
000000r 1               ; =============================================================================
000000r 1               ;   A tokenized BASIC line: 10 SYS 2060
000000r 1               ;   When this program is loaded into $0800 and RUN in BASIC, the SYS command
000000r 1               ;   jumps to the machine code entry point at $080C (decimal 2060).
000000r 1               ;   This stub must remain at the very start of the program.
000000r 1               
000000r 1  0A 08 0A 00  BasicStartup: .byte $0A, $08, $0A, $00, $A5, $32, $30, $36, $30, $00, $00, $00
000004r 1  A5 32 30 36  
000008r 1  30 00 00 00  
00000Cr 1               
00000Cr 1               ; =============================================================================
00000Cr 1               ;   Start — Program entry point ($080C)
00000Cr 1               ; =============================================================================
00000Cr 1               ;   The system is already fully initialized when your program runs:
00000Cr 1               ;     - Hardware probed and initialized (HW_PRESENT is set)
00000Cr 1               ;     - Interrupts enabled, keyboard active
00000Cr 1               ;     - IO_MODE set (video or serial console)
00000Cr 1               ;     - All Kernal jump table routines available
00000Cr 1               ;
00000Cr 1               ;   Return to BASIC with RTS.
00000Cr 1               ; =============================================================================
00000Cr 1               
00000Cr 1               Start:
00000Cr 1               .ifdef VDP
00000Cr 1                 ; --- VDP build only: refuse to run on BIOS 1.x ---
00000Cr 1                 ; A program built with 6502-VDP.inc may call 2.x Kernal entries that are
00000Cr 1                 ; bare RTS slots on 1.x, so it says so and returns to BASIC instead.
00000Cr 1  20 7B A0       jsr KernalVersion             ; A = major, X = minor
00000Fr 1  C9 02          cmp #2
000011r 1  B0 08          bcs @Bios2
000013r 1  A9 rr          lda #<NeedsBios2Msg
000015r 1  A0 rr          ldy #>NeedsBios2Msg
000017r 1  20 90 A0       jsr PrintStr
00001Ar 1  60             rts                           ; Return to BASIC
00001Br 1               @Bios2:
00001Br 1               .endif
00001Br 1               
00001Br 1                 ; === Your program starts here ===
00001Br 1               
00001Br 1                 ; Example: clear screen and print a message
00001Br 1  20 18 A0       jsr VideoClear                ; Clear video screen
00001Er 1               
00001Er 1  A9 rr          lda #<HelloMsg
000020r 1  A0 rr          ldy #>HelloMsg
000022r 1  20 90 A0       jsr PrintStr                  ; Print the message
000025r 1               
000025r 1               @WaitKey:
000025r 1  20 03 A0       jsr Chrin                     ; Poll for a keypress (non-blocking)
000028r 1  90 FB          bcc @WaitKey                  ; Loop until character available (C=1)
00002Ar 1               
00002Ar 1  20 18 A0       jsr VideoClear                ; Clear screen before returning
00002Dr 1  60             rts                           ; Return to BASIC
00002Er 1               
00002Er 1               ; =============================================================================
00002Er 1               ;   Data
00002Er 1               ; =============================================================================
00002Er 1               
00002Er 1               HelloMsg:
00002Er 1  48 65 6C 6C    .byte "Hello from Program!", CHAR_CR, CHAR_LF
000032r 1  6F 20 66 72  
000036r 1  6F 6D 20 50  
000043r 1  50 72 65 73    .byte "Press any key to return to BASIC.", CHAR_CR, CHAR_LF, $00
000047r 1  73 20 61 6E  
00004Br 1  79 20 6B 65  
000067r 1               
000067r 1               .ifdef VDP
000067r 1               NeedsBios2Msg:
000067r 1  4E 45 45 44    .byte "NEEDS BIOS 2 AND A 6502-PICOVDP", CHAR_CR, CHAR_LF, $00
00006Br 1  53 20 42 49  
00006Fr 1  4F 53 20 32  
000089r 1               .endif
000089r 1               
